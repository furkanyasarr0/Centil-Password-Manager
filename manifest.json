{
  "manifest_version": 3,
  "name": "Centil Password Manager",
  "version": "1.0",
  "description": "Secure password manager with Python backend",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "auto_fill_password": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Otomatik doldurma"
    }
  }
}
